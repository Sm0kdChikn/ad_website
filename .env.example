# Database — SQLite (default)
DATABASE_URL="file:./dev.db"

# To use Postgres instead, set:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/adnabbit"
# and change prisma/schema.prisma datasource provider to "postgresql"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Admin seed (used by npm run db:seed)
ADMIN_EMAIL="admin@adnabbit.com"
ADMIN_PASSWORD="change-me"
