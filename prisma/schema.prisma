// AdNabbit MVP — SQLite by default for zero-setup local demos.
// To switch to Postgres: change provider to "postgresql" and set DATABASE_URL
// e.g. postgresql://user:pass@localhost:5432/adnabbit
//
// Note: SQLite has no native enums — Role, status, vertical, inventoryStatus are strings.
// Valid Role: ADVERTISER | ADMIN
// Valid Creative status: DRAFT | PENDING | APPROVED | REJECTED
// Valid HostVertical: see src/lib/types.ts
// Valid InventoryStatus: OPEN | LIMITED | FULL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String?
  role         String             @default("ADVERTISER")
  creatives    Creative[]
  profile      AdvertiserProfile?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Creative {
  id           String    @id @default(cuid())
  name         String
  notes        String?
  fileName     String
  storedName   String
  mimeType     String
  fileSize     Int
  status       String    @default("DRAFT")
  rejectReason String?
  advertiserId String
  advertiser   User      @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Venue / host location. Screens inherit vertical from Host (not stored on Screen).
model Host {
  id         String   @id @default(cuid())
  name       String
  /// Primary vertical (HostVertical enum as string)
  vertical   String
  /// Required when vertical is OTHER
  otherLabel String?
  notes      String?
  screens    Screen[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Screen {
  id              String   @id @default(cuid())
  name            String
  city            String
  zip             String
  /// OPEN | LIMITED | FULL
  inventoryStatus String   @default("OPEN")
  notes           String?
  hostId          String
  host            Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([city])
  @@index([zip])
  @@index([inventoryStatus])
  @@index([hostId])
}

/// Ticket B — public advertiser profile (1:1 with User)
model AdvertiserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// URL-safe unique slug for /a/[slug]
  slug            String   @unique
  displayName     String
  pitch           String?
  website         String?
  /// Phone or email contact
  contact         String?
  /// Uploaded logo file under uploads/
  logoStoredName  String?
  /// External logo URL (alternative to upload)
  logoUrl         String?
  category        String?
  /// Comma/space-separated ZIP codes or free-form service area
  serviceAreaZips String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published])
}
